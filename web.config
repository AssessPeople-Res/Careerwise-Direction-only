<?xml version="1.0" encoding="UTF-8"?>
<!--
  Notice-only site: every URL that is not index.html or one of its assets
  (css, fonts, img) shows the "services discontinued" page via 404.html,
  which uses root-absolute asset paths so it renders at any URL depth.
  Uses only built-in IIS features (no URL Rewrite module required).
-->
<configuration>
    <system.web>
        <customErrors mode="Off" />
    </system.web>
    <system.webServer>
        <defaultDocument enabled="true">
            <files>
                <clear />
                <add value="index.html" />
            </files>
        </defaultDocument>
        <directoryBrowse enabled="false" />
        <httpErrors errorMode="Custom" existingResponse="Replace">
            <remove statusCode="403" />
            <remove statusCode="404" />
            <remove statusCode="405" />
            <remove statusCode="500" />
            <error statusCode="403" path="/404.html" responseMode="ExecuteURL" />
            <error statusCode="404" path="/404.html" responseMode="ExecuteURL" />
            <error statusCode="405" path="/404.html" responseMode="ExecuteURL" />
            <error statusCode="500" path="/404.html" responseMode="ExecuteURL" />
        </httpErrors>
    </system.webServer>
</configuration>
